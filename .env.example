# Template: list variable names only. Put secrets in `.env.local` (development)
# and `.env.test` (test) which are gitignored.

# Postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=invoicing_dev

# Test DB used by Makefile/tests
DB_NAME_TEST=invoicing_test

# App
SECRET_KEY=replace-with-secure-secret
ENV=development
DEBUG=true

# Message broker
RABBITMQ_URL=amqp://guest:guest@rabbit:5672/

# Optional
SENTRY_DSN=
