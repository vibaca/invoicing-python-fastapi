# .env.example
# Copia este archivo a .env y ajusta valores según tu entorno.

# === Common ===
# Entorno de la aplicación: 'development' o 'test'
APP_ENV=test
# Debug True/False
APP_DEBUG=false
# Secret key para cifrado/firmas
SECRET_KEY=changeme_replace_this_with_a_strong_key
# Nivel de logs: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# === Database (defaults for dev) ===
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=db
DB_PORT=5432
DB_NAME=invoicing_test
# Alternativamente puedes especificar DATABASE_URL completo
# ej: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/invoicing_test

# === Test settings ===
# Para pruebas, puedes cambiar DB_NAME a 'invoicing_test' o activar TEST_MODE
# TEST_MODE=1 fuerza modo test (útil en CI)
TEST_MODE=1
# Ejemplo de valores para test (descomenta/modifica cuando uses test env)
# APP_ENV=test
# APP_DEBUG=false
# DB_NAME=invoicing_test
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/invoicing_test

# === Notas ===
# - Copia con: cp .env.example .env
# - En CI o entornos de prueba, ajusta TEST_MODE=1 o setea DB_NAME a ending _test
